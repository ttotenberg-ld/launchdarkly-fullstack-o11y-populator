# LaunchDarkly Configuration
# Get your SDK key from: https://app.launchdarkly.com/settings/projects

# Server-side SDK key (for backend services)
LD_SDK_KEY=sdk-xxxxx

# Client-side ID (for frontend)
VITE_LD_CLIENT_SIDE_ID=xxxxx

# Environment name
ENVIRONMENT=production

# Service version — bump on every substantive change. Flows to all backend
# services and to the frontend bundle. Shows up as `service.version` in LD.
SERVICE_VERSION=2.0.3

# Traffic Simulator Configuration
# Number of browser sessions to start per minute (each ~60 seconds long)
SESSIONS_PER_MINUTE=2
# Target duration for each session in seconds
TARGET_SESSION_DURATION=60
# Max concurrent browser instances
MAX_CONCURRENT_BROWSERS=3

# AI Chat Configuration — three modes:
#
# 1. No LLM (default for easy dev/testing):
#    CHAT_ENABLED=false
#    docker compose up -d --build
#    → Chat widget shows "down for maintenance" message, no Ollama needed
#
# 2. Local LLM (Docker-based Ollama — CPU-only on Mac, slow but self-contained):
#    CHAT_ENABLED=true
#    OLLAMA_URL=http://ollama:11434
#    docker compose --profile local-models up -d --build
#
# 3. Native/remote LLM (GPU-accelerated — fast, recommended for Mac):
#    CHAT_ENABLED=true
#    OLLAMA_URL=http://host.docker.internal:11434   (native Mac Ollama)
#    OLLAMA_URL=http://your-server:11434             (remote/shared server)
#    docker compose up -d --build
#
CHAT_ENABLED=false
OLLAMA_URL=http://ollama:11434

# Postgres Configuration
# The postgres container runs locally in docker-compose; services reach it
# at `postgres:5432` over the internal network. Ephemeral: no volume, so
# every `docker compose up` reseeds from postgres/initdb/*.sql.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=postgres

# Payment service connection pool overrides.
# Defaults match SQLAlchemy's defaults (5 + 10 overflow). The
# `payment-processor-migration` flag's v2 scenario demos pool exhaustion
# by evaluating at runtime — these values are just the steady-state baseline.
PAYMENT_DB_POOL_SIZE=5
PAYMENT_DB_MAX_OVERFLOW=10
