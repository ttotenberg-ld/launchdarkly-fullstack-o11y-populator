# LaunchDarkly Configuration
# Get your SDK key from: https://app.launchdarkly.com/settings/projects

# Server-side SDK key (for backend services)
LD_SDK_KEY=sdk-xxxxx

# Client-side ID (for frontend)
VITE_LD_CLIENT_SIDE_ID=xxxxx

# Environment name
ENVIRONMENT=production

# Traffic Simulator Configuration
# Number of browser sessions to start per minute (each ~60 seconds long)
SESSIONS_PER_MINUTE=2
# Target duration for each session in seconds
TARGET_SESSION_DURATION=60
# Max concurrent browser instances
MAX_CONCURRENT_BROWSERS=3

# AI Chat Configuration — three modes:
#
# 1. No LLM (default for easy dev/testing):
#    CHAT_ENABLED=false
#    docker compose up -d --build
#    → Chat widget shows "down for maintenance" message, no Ollama needed
#
# 2. Local LLM (Docker-based Ollama — CPU-only on Mac, slow but self-contained):
#    CHAT_ENABLED=true
#    OLLAMA_URL=http://ollama:11434
#    docker compose --profile local-models up -d --build
#
# 3. Native/remote LLM (GPU-accelerated — fast, recommended for Mac):
#    CHAT_ENABLED=true
#    OLLAMA_URL=http://host.docker.internal:11434   (native Mac Ollama)
#    OLLAMA_URL=http://your-server:11434             (remote/shared server)
#    docker compose up -d --build
#
CHAT_ENABLED=false
OLLAMA_URL=http://ollama:11434
