# LaunchDarkly Configuration
# Get your SDK key from: https://app.launchdarkly.com/settings/projects

# Server-side SDK key (for backend services)
LD_SDK_KEY=sdk-xxxxx

# Client-side ID (for frontend)
VITE_LD_CLIENT_SIDE_ID=xxxxx

# Environment name
ENVIRONMENT=production

# Traffic Simulator Configuration
# Number of browser sessions to start per minute (each ~60 seconds long)
SESSIONS_PER_MINUTE=2
# Target duration for each session in seconds
TARGET_SESSION_DURATION=60
# Max concurrent browser instances
MAX_CONCURRENT_BROWSERS=3

# Ollama LLM Server URL
# Local mode: docker compose --profile local-models up (uses http://ollama:11434 automatically)
# Team mode:  point at a shared central Ollama server
OLLAMA_URL=http://ollama:11434
